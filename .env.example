# Paperclip — Conexão Azul Growth Machine
# Copiar para .env e preencher os valores reais

BETTER_AUTH_SECRET=<gere com: python3 -c "import secrets; print(secrets.token_hex(32))">
PAPERCLIP_DB_PASSWORD=<senha forte>
PAPERCLIP_PUBLIC_URL=http://localhost:3100

# Quando exposto via Traefik (futuro):
# PAPERCLIP_PUBLIC_URL=https://paperclip.conexaoazul.com

TZ=America/Sao_Paulo

